# Copia este archivo como ".env" (local) o, mejor, crea estos mismos nombres
# como "Repository variables" en GitHub (Settings > Secrets and variables > Actions > Variables)
# para que el build en línea los use sin que tengas que instalar nada en tu PC.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

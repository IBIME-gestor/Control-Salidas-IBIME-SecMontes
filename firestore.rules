rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTENTICACIÓN
    // ============================================================

    function estaAutenticado() {
      return request.auth != null;
    }

    // ============================================================
    // ADMINISTRADOR INICIAL
    // ============================================================

    function correoEsAdminInicial(correo) {
      return correo == 'josue.jain@ibime.edu.mx';
    }

    function esCorreoPropio(correo) {
      return estaAutenticado() && request.auth.token.email.lower() == correo;
    }

    // ============================================================
    // PERFIL DEL USUARIO
    // ============================================================

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.token.email.lower());
    }

    function perfilExiste() {
      return estaAutenticado() && exists(rutaPerfil());
    }

    function perfil() {
      return perfilExiste()
        ? get(rutaPerfil()).data
        : {};
    }

    // ============================================================
    // ROLES
    // ============================================================

    function tieneRol(rol) {
      return perfilExiste()
        && ('roles' in perfil())
        && (rol in perfil().roles);
    }

    // IMPORTANTE:
    // El administrador inicial NO necesita existir todavía
    // en Firestore para ser reconocido como administrador.

    function esAdmin() {
      return estaAutenticado() &&
        (
          correoEsAdminInicial(request.auth.token.email.lower()) ||
          tieneRol('administrador')
        );
    }

    // ============================================================
    // PERMISOS
    // ============================================================

    function tienePermiso(permiso) {
      return estaAutenticado() &&
        (
          esAdmin() ||
          (
            perfilExiste() &&
            ('permisos' in perfil()) &&
            (permiso in perfil().permisos) &&
            perfil().permisos[permiso] == true
          )
        );
    }

    function puedeEditarAlumnos() {
      return tienePermiso('editarAlumnos');
    }

    function puedeGestionarTiposSalida() {
      return tienePermiso('gestionarTiposSalida');
    }

    function puedeTomarAsistencia() {
      return tienePermiso('tomarAsistencia');
    }

    function puedeCapturarRetardos() {
      return tienePermiso('capturarRetardos');
    }

    function puedeOtorgarSalidaAnticipada() {
      return tienePermiso('salidaAnticipada');
    }

    // ============================================================
    // AUTOAPROVISIONAMIENTO (alta automática al primer inicio de sesión)
    // ============================================================
    //
    // El navegador (src/context/AuthContext.jsx) crea el propio perfil de
    // la persona la primera vez que entra con Google. Esta es la barrera
    // real de seguridad para eso: SOLO se permite crear el documento con
    // el correo propio, SOLO si no existía ya, y SOLO con el rol
    // "docente" (o "administrador" si el correo está en la lista de
    // administradores iniciales) — nunca con otro rol, ni con un grupo o
    // tutoría ya asignados de entrada.
    function esAutoAprovisionamientoValido(correo) {
      return esCorreoPropio(correo) &&
        !perfilExiste() &&
        ('roles' in request.resource.data) &&
        request.resource.data.roles.size() == 1 &&
        (
          (correoEsAdminInicial(correo) && request.resource.data.roles[0] == 'administrador') ||
          (!correoEsAdminInicial(correo) && request.resource.data.roles[0] == 'docente')
        ) &&
        request.resource.data.grupoAsignado == '' &&
        request.resource.data.tutorAsignado == '';
    }

    // ============================================================
    // ALUMNOS
    // ============================================================

    function soloActualizaContadores() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'contadorRetardos',
          'contadorFaltas'
        ]);
    }

    // ============================================================
    // USUARIOS
    // ============================================================

    match /usuarios/{correo} {

      // Un usuario puede consultar su propio perfil.
      // Un administrador puede consultar cualquiera.
      allow read: if estaAutenticado() &&
        (
          request.auth.token.email.lower() == correo ||
          esAdmin()
        );

      // Un administrador puede crear usuarios. Cualquier otra persona
      // SOLO puede crear su propio documento, y solo como autoaprovisionamiento
      // válido (ver función arriba) — nunca con un rol o privilegios de más.
      allow create: if esAdmin() || esAutoAprovisionamientoValido(correo);

      // SOLO un administrador puede modificar usuarios.
      allow update: if esAdmin();

      // SOLO un administrador puede eliminar usuarios.
      allow delete: if esAdmin();
    }

    // ============================================================
    // ALUMNOS
    // ============================================================

    match /alumnos/{alumnoId} {

      allow read: if estaAutenticado();

      allow create: if puedeEditarAlumnos();

      allow update: if puedeEditarAlumnos() ||
        (
          (
            puedeTomarAsistencia() ||
            puedeCapturarRetardos()
          ) &&
          soloActualizaContadores()
        );

      allow delete: if esAdmin();

      // ----------------------------------------------------------
      // COMENTARIOS
      // ----------------------------------------------------------

      match /comentarios/{comentarioId} {

        allow read: if estaAutenticado();

        allow create: if estaAutenticado();

        allow update, delete: if esAdmin();
      }
    }

    // ============================================================
    // TIPOS DE SALIDA
    // ============================================================

    match /tiposSalida/{tipoId} {

      allow read: if estaAutenticado();

      allow write: if puedeGestionarTiposSalida();
    }

    // ============================================================
    // EVENTOS
    // ============================================================

    match /eventos/{eventoId} {

      allow read: if estaAutenticado();

      allow create: if estaAutenticado() &&
        (
          request.resource.data.accion != 'SALIDA_ANTICIPADA' ||
          puedeOtorgarSalidaAnticipada()
        );

      allow update, delete: if esAdmin();
    }

    // ============================================================
    // SUPERVISORES
    // ============================================================

    match /supervisores/{supervisorId} {

      allow read: if estaAutenticado();

      allow write: if puedeGestionarTiposSalida();
    }

    // ============================================================
    // ASISTENCIA
    // ============================================================

    match /asistencia/{asistenciaId} {

      allow read: if estaAutenticado();

      allow create, update: if
        puedeTomarAsistencia() ||
        puedeCapturarRetardos();

      allow delete: if esAdmin();
    }

    // ============================================================
    // META
    // ============================================================

    match /meta/{metaId} {

      allow read: if estaAutenticado();

      allow write: if esAdmin();
    }

    // ============================================================
    // HORARIOS
    // ============================================================

    match /horarios/{horarioId} {

      allow read: if estaAutenticado();

      allow write: if esAdmin();
    }

    // ============================================================
    // SALIDA (bitácora de salida normal, por fecha, para consultas
    // posteriores — ver src/utils/salidas.js)
    // ============================================================
    //
    //   salida/registro/{fecha}/{alumnoId}
    //
    // Cualquier persona autenticada puede registrar (la pantalla de
    // salida del docente y la de estancia son las únicas que escriben
    // aquí); solo el administrador puede corregir o borrar un registro
    // ya guardado.

    match /salida/{fijo} {

      allow read: if estaAutenticado();
      allow write: if esAdmin();

      match /{fecha}/{alumnoId} {

        allow read: if estaAutenticado();
        allow create, update: if estaAutenticado();
        allow delete: if esAdmin();
      }
    }

    // ============================================================
    // ASIGNACIONES DE ESTANCIA
    // ============================================================
    //
    // Qué días, en qué salón y para qué grado(s) recibe alumnos cada
    // profe de estancia. Lo administra solo el administrador desde el
    // panel "Estancia"; cualquier persona autenticada puede leerlo (lo
    // necesita el propio profe de estancia para saber su turno de hoy).

    match /asignacionesEstancia/{correo} {

      allow read: if estaAutenticado();

      allow write: if esAdmin();
    }

    // ============================================================
    // CONFIGURACIÓN GENERAL
    // ============================================================
    //
    // configuracion/estancia → { horaTraslado: "HH:MM" }, la hora a
    // partir de la cual el panel del docente avisa que ya deben
    // trasladarse los alumnos pendientes a estancia. Solo el
    // administrador la cambia; cualquiera autenticado la lee.

    match /configuracion/{id} {

      allow read: if estaAutenticado();

      allow write: if esAdmin();
    }

    // ============================================================
    // SELECCIÓN DIARIA DEL DOCENTE
    // ============================================================
    //
    // seleccionDiaria/{fecha}_{correo} → con qué grupo termina el día
    // cada docente, o si tiene "hora administrativa". Cada quien solo
    // puede escribir SU PROPIA selección (nunca la de alguien más); el
    // administrador puede leer y corregir cualquiera.

    match /seleccionDiaria/{id} {

      allow read: if estaAutenticado();

      allow create, update: if esAdmin() ||
        (estaAutenticado() && request.resource.data.correo == request.auth.token.email.lower());

      allow delete: if esAdmin();
    }

    // ============================================================
    // TRANSPORTE
    // ============================================================
    //
    // rutasTransporte/{id}        → catálogo de rutas con su operador.
    // transporteAlumnos/{alumnoId} → qué ruta/operador tiene cada alumno.
    //
    // Las administra el administrador o quien tenga el rol Transporte
    // (coordinador de transporte); cualquier persona autenticada puede
    // leerlas — el docente necesita verlas al momento de la salida.

    match /rutasTransporte/{id} {

      allow read: if estaAutenticado();

      allow write: if esAdmin() || tieneRol('transporte');
    }

    match /transporteAlumnos/{alumnoId} {

      allow read: if estaAutenticado();

      allow write: if esAdmin() || tieneRol('transporte');
    }
  }
}

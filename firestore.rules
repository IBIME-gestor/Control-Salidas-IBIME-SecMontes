rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTENTICACIÓN
    // ============================================================

    function estaAutenticado() {
      return request.auth != null;
    }

    // ============================================================
    // ADMINISTRADOR INICIAL
    // ============================================================

    function correoEsAdminInicial(correo) {
      return correo == 'josue.jain@ibime.edu.mx';
    }

    // ============================================================
    // PERFIL DEL USUARIO
    // ============================================================

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.token.email.lower());
    }

    function perfilExiste() {
      return estaAutenticado() && exists(rutaPerfil());
    }

    function perfil() {
      return perfilExiste()
        ? get(rutaPerfil()).data
        : {};
    }

    // ============================================================
    // ROLES
    // ============================================================

    function tieneRol(rol) {
      return perfilExiste()
        && ('roles' in perfil())
        && (rol in perfil().roles);
    }

    // IMPORTANTE:
    // El administrador inicial NO necesita existir todavía
    // en Firestore para ser reconocido como administrador.

    function esAdmin() {
      return estaAutenticado() &&
        (
          correoEsAdminInicial(request.auth.token.email.lower()) ||
          tieneRol('administrador')
        );
    }

    // ============================================================
    // PERMISOS
    // ============================================================

    function tienePermiso(permiso) {
      return estaAutenticado() &&
        (
          esAdmin() ||
          (
            perfilExiste() &&
            ('permisos' in perfil()) &&
            (permiso in perfil().permisos) &&
            perfil().permisos[permiso] == true
          )
        );
    }

    function puedeEditarAlumnos() {
      return tienePermiso('editarAlumnos');
    }

    function puedeGestionarTiposSalida() {
      return tienePermiso('gestionarTiposSalida');
    }

    function puedeTomarAsistencia() {
      return tienePermiso('tomarAsistencia');
    }

    function puedeCapturarRetardos() {
      return tienePermiso('capturarRetardos');
    }

    function puedeOtorgarSalidaAnticipada() {
      return tienePermiso('salidaAnticipada');
    }

    // ============================================================
    // ALUMNOS
    // ============================================================

    function soloActualizaContadores() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'contadorRetardos',
          'contadorFaltas'
        ]);
    }

    // ============================================================
    // USUARIOS
    // ============================================================

    match /usuarios/{correo} {

      // Un usuario puede consultar su propio perfil.
      // Un administrador puede consultar cualquiera.
      allow read: if estaAutenticado() &&
        (
          request.auth.token.email.lower() == correo ||
          esAdmin()
        );

      // SOLO un administrador puede crear usuarios.
      allow create: if esAdmin();

      // SOLO un administrador puede modificar usuarios.
      allow update: if esAdmin();

      // SOLO un administrador puede eliminar usuarios.
      allow delete: if esAdmin();
    }

    // ============================================================
    // ALUMNOS
    // ============================================================

    match /alumnos/{alumnoId} {

      allow read: if estaAutenticado();

      allow create: if puedeEditarAlumnos();

      allow update: if puedeEditarAlumnos() ||
        (
          (
            puedeTomarAsistencia() ||
            puedeCapturarRetardos()
          ) &&
          soloActualizaContadores()
        );

      allow delete: if esAdmin();

      // ----------------------------------------------------------
      // COMENTARIOS
      // ----------------------------------------------------------

      match /comentarios/{comentarioId} {

        allow read: if estaAutenticado();

        allow create: if estaAutenticado();

        allow update, delete: if esAdmin();
      }
    }

    // ============================================================
    // TIPOS DE SALIDA
    // ============================================================

    match /tiposSalida/{tipoId} {

      allow read: if estaAutenticado();

      allow write: if puedeGestionarTiposSalida();
    }

    // ============================================================
    // EVENTOS
    // ============================================================

    match /eventos/{eventoId} {

      allow read: if estaAutenticado();

      allow create: if estaAutenticado() &&
        (
          request.resource.data.accion != 'SALIDA_ANTICIPADA' ||
          puedeOtorgarSalidaAnticipada()
        );

      allow update, delete: if esAdmin();
    }

    // ============================================================
    // SUPERVISORES
    // ============================================================

    match /supervisores/{supervisorId} {

      allow read: if estaAutenticado();

      allow write: if puedeGestionarTiposSalida();
    }

    // ============================================================
    // ASISTENCIA
    // ============================================================

    match /asistencia/{asistenciaId} {

      allow read: if estaAutenticado();

      allow create, update: if
        puedeTomarAsistencia() ||
        puedeCapturarRetardos();

      allow delete: if esAdmin();
    }

    // ============================================================
    // META
    // ============================================================

    match /meta/{metaId} {

      allow read: if estaAutenticado();

      allow write: if esAdmin();
    }

    // ============================================================
    // HORARIOS
    // ============================================================

    match /horarios/{horarioId} {

      allow read: if estaAutenticado();

      allow write: if esAdmin();
    }
  }
}
